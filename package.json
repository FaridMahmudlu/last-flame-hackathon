{
  "name": "last-flame",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "An atmospheric cooperative escape game for iOS, Android, and web.",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "expo start --lan",
    "start:usb": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --localhost --max-workers 2",
    "android": "expo start --android --lan",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/engine.test.ts tests/server.test.ts",
    "test:engine": "node --import tsx --test tests/engine.test.ts",
    "test:ui": "playwright test",
    "test:android": "node scripts/android-smoke.mjs",
    "build:web": "expo export --platform web --max-workers 2",
    "build:native": "expo export --platform all --output-dir .expo/export-native --max-workers 2",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:web"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "57.0.15",
    "expo": "57.0.22",
    "expo-audio": "57.0.5",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.18",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linear-gradient": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "lucide-react-native": "1.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.4",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "sharp": "0.35.4",
    "svg-pathdata": "9.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
